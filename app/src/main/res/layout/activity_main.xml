<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 博主雷达"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="打开小红书时，自动高亮名单里的博主"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:text="状态加载中…"
            android:textColor="#111827"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnImport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#EF4444"
            android:text="① 导入 Excel 名单（.xls）"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2563EB"
            android:text="② 开启无障碍服务"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="小红书内实时高亮标记"
                android:textColor="#111827"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/swEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#9CA3AF"
            android:text="清空名单"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="📊 点赞/收藏统计"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="做数据时工具会自动记录。每个博主每个账号每天上限 3 次（赞+藏），到顶会变橙色提醒。"
            android:textColor="#6B7280"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="当前账号："
                android:textColor="#111827"
                android:textSize="15sp" />

            <Spinner
                android:id="@+id/spinnerAccount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnAddAccount"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#10B981"
                android:text="＋"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvToday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="今日统计：暂无"
            android:textColor="#111827"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#7C3AED"
            android:text="③ 导出 Excel（博主×账号×日期）"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnDump"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#0EA5E9"
            android:text="🔍 抓取当前屏幕节点（诊断用）"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="停在小红书发现页，点上面按钮 → 约1秒后自动抓取 → 用微信把生成的 txt 发我，我据此定位发现页作者名在哪里"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#FEF3C7"
            android:lineSpacingExtra="4dp"
            android:padding="14dp"
            android:text="使用说明：\n1. 表格里的博主昵称请整理成一列或一个区域（空行/空列会自动跳过）\n2. 支持 .xls（Excel 97-2003）；如果是 .xlsx，请用 Excel「另存为」选 .xls\n3. 开启无障碍服务后，打开小红书，名单中的博主昵称会被绿色框高亮\n4. 小红书列表里超长昵称会显示成「xxx…」，本工具已做模糊匹配\n5. 切号做数据前，先在上方把「当前账号」切到正在用的号\n6. 所有数据仅保存在手机本地，不会联网上传"
            android:textColor="#92400E"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
